rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Pillar 4.1: Global default-deny safety net
    match /{document=**} {
      allow read, write: if false;
    }

    // =========================================================
    // GLOBAL HARDENED PRIMITIVES
    // =========================================================
    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isVerifiedUser() {
      return isSignedIn() && request.auth.token.email_verified == true;
    }

    // Token-only admin check safe for list queries (no get/exists inside list)
    function isAdminToken() {
      return isVerifiedUser() && (
        request.auth.token.email == 'sa33.5g.2022@gmail.com' ||
        request.auth.token.email == 'alfauzy80@gmail.com'
      );
    }

    function isAdmin() {
      return isVerifiedUser() && (
        isAdminToken() ||
        exists(/databases/$(database)/documents/admins/$(request.auth.uid))
      );
    }

    // =========================================================
    // VALIDATION BLUEPRINTS
    // =========================================================
    function isValidAdminEntry(data) {
      return data.keys().hasAll(['uid', 'email', 'role', 'createdAt'])
        && data.keys().hasOnly(['uid', 'email', 'role', 'createdAt'])
        && isValidId(data.uid)
        && data.email is string && data.email.size() >= 3 && data.email.size() <= 160
        && data.role == 'admin'
        && data.createdAt is timestamp;
    }

    function isValidUserProfile(data) {
      return data.keys().hasAll(['uid', 'nama', 'email', 'role', 'status', 'soundEnabled', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly(['uid', 'nama', 'email', 'whatsapp', 'custId', 'role', 'status', 'soundEnabled', 'createdAt', 'updatedAt'])
        && isValidId(data.uid)
        && data.nama is string && data.nama.size() >= 1 && data.nama.size() <= 120
        && data.email is string && data.email.size() <= 160
        && (!('whatsapp' in data) || (data.whatsapp is string && data.whatsapp.size() <= 32))
        && (!('custId' in data) || (data.custId is string && data.custId.size() <= 64))
        && (data.role == 'admin' || data.role == 'customer')
        && (data.status == 'Aktif' || data.status == 'Nonaktif')
        && data.soundEnabled is bool
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidCustomerRecord(data) {
      return data.keys().hasAll([
        'id', 'ownerUid', 'officialName', 'whatsapp', 'productLabel',
        'activeLoan', 'monthlyInstallment', 'paidInstallments',
        'totalInstallments', 'loanTenor', 'remainingDebt',
        'dueDateDay', 'status', 'loans', 'updatedAt'
      ])
        && data.keys().hasOnly([
          'id', 'ownerUid', 'officialName', 'whatsapp', 'productLabel',
          'activeLoan', 'monthlyInstallment', 'paidInstallments',
          'totalInstallments', 'loanTenor', 'remainingDebt',
          'dueDateDay', 'status', 'loans', 'updatedAt'
        ])
        && isValidId(data.id)
        && data.ownerUid is string && data.ownerUid.size() <= 128
        && data.officialName is string && data.officialName.size() >= 1 && data.officialName.size() <= 120
        && data.whatsapp is string && data.whatsapp.size() >= 5 && data.whatsapp.size() <= 32
        && data.productLabel is string && data.productLabel.size() <= 200
        && data.activeLoan is number && data.activeLoan >= 0
        && data.monthlyInstallment is number && data.monthlyInstallment >= 0
        && data.paidInstallments is number && data.paidInstallments >= 0
        && data.totalInstallments is number && data.totalInstallments >= 0
        && data.loanTenor is string && data.loanTenor.size() <= 64
        && data.remainingDebt is number && data.remainingDebt >= 0
        && data.dueDateDay is string && data.dueDateDay.size() <= 32
        && (data.status == 'Aktif' || data.status == 'Berjalan')
        && data.loans is list && data.loans.size() <= 20
        && (data.loans.size() == 0 || (data.loans[0] is map && data.loans[0].keys().hasAll(['id', 'productName'])))
        && data.updatedAt is timestamp;
    }

    function isValidSavingsAccount(data) {
      return data.keys().hasAll([
        'id', 'ownerUid', 'officialName', 'whatsapp', 'program',
        'routine', 'balance', 'lastDate', 'status', 'updatedAt'
      ])
        && data.keys().hasOnly([
          'id', 'ownerUid', 'officialName', 'whatsapp', 'program',
          'routine', 'balance', 'lastDate', 'status', 'updatedAt'
        ])
        && isValidId(data.id)
        && data.ownerUid is string && data.ownerUid.size() <= 128
        && data.officialName is string && data.officialName.size() >= 1 && data.officialName.size() <= 120
        && data.whatsapp is string && data.whatsapp.size() <= 32
        && (
          data.program == 'Menabung Harian' ||
          data.program == 'Menabung Mingguan' ||
          data.program == 'Menabung Bulanan'
        )
        && data.routine is string && data.routine.size() <= 120
        && data.balance is number && data.balance >= 0
        && data.lastDate is string && data.lastDate.size() <= 32
        && (data.status == 'Aktif' || data.status == 'Nonaktif')
        && data.updatedAt is timestamp;
    }

    function isValidConversation(data) {
      return data.keys().hasAll([
        'conversationId', 'adminId', 'customerId', 'customerUid',
        'customerName', 'lastMessage', 'lastMessageAt',
        'unreadAdmin', 'unreadCustomer'
      ])
        && data.keys().hasOnly([
          'conversationId', 'adminId', 'customerId', 'customerUid',
          'customerName', 'customerWhatsapp', 'lastMessage',
          'lastMessageAt', 'unreadAdmin', 'unreadCustomer'
        ])
        && isValidId(data.conversationId)
        && data.adminId is string && data.adminId.size() <= 128
        && isValidId(data.customerId)
        && data.customerUid is string && data.customerUid.size() <= 128
        && data.customerName is string && data.customerName.size() >= 1 && data.customerName.size() <= 120
        && (!('customerWhatsapp' in data) || (data.customerWhatsapp is string && data.customerWhatsapp.size() <= 32))
        && data.lastMessage is string && data.lastMessage.size() <= 1000
        && data.lastMessageAt is timestamp
        && data.unreadAdmin is number && data.unreadAdmin >= 0
        && data.unreadCustomer is number && data.unreadCustomer >= 0;
    }

    function isValidMessage(data) {
      return data.keys().hasAll([
        'messageId', 'conversationId', 'customerUid', 'senderId',
        'senderRole', 'senderName', 'message', 'messageType',
        'createdAt', 'status'
      ])
        && data.keys().hasOnly([
          'messageId', 'conversationId', 'customerUid', 'senderId',
          'senderRole', 'senderName', 'message', 'messageType',
          'imageUrl', 'transactionId', 'createdAt', 'deliveredAt',
          'readAt', 'status'
        ])
        && isValidId(data.messageId)
        && isValidId(data.conversationId)
        && data.customerUid is string && data.customerUid.size() <= 128
        && data.senderId is string && data.senderId.size() >= 1 && data.senderId.size() <= 128
        && (data.senderRole == 'admin' || data.senderRole == 'customer' || data.senderRole == 'system')
        && data.senderName is string && data.senderName.size() >= 1 && data.senderName.size() <= 120
        && data.message is string && data.message.size() <= 4000
        && (data.messageType == 'text' || data.messageType == 'system_payment' || data.messageType == 'image')
        && (!('imageUrl' in data) || (data.imageUrl is string && data.imageUrl.size() <= 1000))
        && (!('transactionId' in data) || (data.transactionId is string && data.transactionId.size() <= 128))
        && data.createdAt is timestamp
        && (!('deliveredAt' in data) || data.deliveredAt == null || data.deliveredAt is timestamp)
        && (!('readAt' in data) || data.readAt == null || data.readAt is timestamp)
        && (data.status == 'sent' || data.status == 'delivered' || data.status == 'read');
    }

    function isValidTransaction(data) {
      return data.keys().hasAll([
        'transactionId', 'customerId', 'customerUid', 'officialName',
        'adminId', 'description', 'nominal', 'tanggal',
        'jenisTransaksi', 'sisaTagihan', 'status', 'createdAt'
      ])
        && data.keys().hasOnly([
          'transactionId', 'customerId', 'customerUid', 'officialName',
          'adminId', 'loanId', 'description', 'nominal', 'tanggal',
          'jenisTransaksi', 'sisaTagihan', 'status', 'createdAt'
        ])
        && isValidId(data.transactionId)
        && isValidId(data.customerId)
        && data.customerUid is string && data.customerUid.size() <= 128
        && data.officialName is string && data.officialName.size() >= 1 && data.officialName.size() <= 120
        && data.adminId is string && data.adminId.size() >= 1 && data.adminId.size() <= 128
        && (!('loanId' in data) || (data.loanId is string && data.loanId.size() <= 64))
        && data.description is string && data.description.size() >= 1 && data.description.size() <= 300
        && data.nominal is number && data.nominal >= 0
        && data.tanggal is string && data.tanggal.size() >= 1 && data.tanggal.size() <= 32
        && (data.jenisTransaksi == 'loan' || data.jenisTransaksi == 'savings' || data.jenisTransaksi == 'payment_proof')
        && data.sisaTagihan is number && data.sisaTagihan >= 0
        && (
          data.status == 'Terverifikasi' ||
          data.status == 'Berhasil' ||
          data.status == 'Menunggu Verifikasi' ||
          data.status == 'Menunggu'
        )
        && data.createdAt is timestamp;
    }

    function isValidNotification(data) {
      return data.keys().hasAll([
        'notificationId', 'recipientId', 'recipientUid', 'senderId',
        'title', 'body', 'type', 'isRead', 'createdAt'
      ])
        && data.keys().hasOnly([
          'notificationId', 'recipientId', 'recipientUid', 'senderId',
          'title', 'body', 'type', 'transactionId', 'conversationId',
          'isRead', 'createdAt'
        ])
        && isValidId(data.notificationId)
        && data.recipientId is string && data.recipientId.size() >= 1 && data.recipientId.size() <= 128
        && data.recipientUid is string && data.recipientUid.size() <= 128
        && data.senderId is string && data.senderId.size() >= 1 && data.senderId.size() <= 128
        && data.title is string && data.title.size() >= 1 && data.title.size() <= 200
        && data.body is string && data.body.size() >= 1 && data.body.size() <= 1000
        && (
          data.type == 'CHAT_MESSAGE' ||
          data.type == 'TRANSACTION_ALERT' ||
          data.type == 'SAVINGS_ALERT' ||
          data.type == 'SYSTEM_INFO'
        )
        && (!('transactionId' in data) || (data.transactionId is string && data.transactionId.size() <= 128))
        && (!('conversationId' in data) || (data.conversationId is string && data.conversationId.size() <= 64))
        && data.isRead is bool
        && data.createdAt is timestamp;
    }

    function isValidDeviceToken(data) {
      return data.keys().hasAll([
        'tokenId', 'userId', 'custId', 'role', 'fcmToken',
        'platform', 'soundEnabled', 'createdAt', 'updatedAt'
      ])
        && data.keys().hasOnly([
          'tokenId', 'userId', 'custId', 'role', 'fcmToken',
          'platform', 'soundEnabled', 'createdAt', 'updatedAt'
        ])
        && isValidId(data.tokenId)
        && isValidId(data.userId)
        && data.custId is string && data.custId.size() <= 64
        && (data.role == 'admin' || data.role == 'customer')
        && data.fcmToken is string && data.fcmToken.size() >= 10 && data.fcmToken.size() <= 512
        && data.platform is string && data.platform.size() >= 1 && data.platform.size() <= 64
        && data.soundEnabled is bool
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    // =========================================================
    // COLLECTION RULES
    // =========================================================
    match /admins/{adminId} {
      allow get: if isSignedIn() && isValidId(adminId) && (request.auth.uid == adminId || isAdmin());
      allow list: if isAdminToken();
      allow create: if isAdmin() && isValidId(adminId) && isValidAdminEntry(incoming())
        && incoming().uid == adminId && incoming().createdAt == request.time;
      allow update: if isAdmin() && isValidId(adminId) && isValidAdminEntry(incoming())
        && incoming().uid == existing().uid && incoming().createdAt == existing().createdAt;
      allow delete: if isAdmin() && isValidId(adminId);
    }

    match /users/{userId} {
      allow get: if isSignedIn() && isValidId(userId) && (request.auth.uid == userId || isAdmin());
      allow list: if isAdminToken() || (isSignedIn() && resource.data.uid == request.auth.uid);
      allow create: if isVerifiedUser() && isValidId(userId) && isValidUserProfile(incoming())
        && incoming().uid == userId
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time
        && (
          isAdmin() ||
          (request.auth.uid == userId && incoming().role == 'customer' && incoming().status == 'Aktif')
        );
      allow update: if isVerifiedUser() && isValidId(userId) && isValidUserProfile(incoming())
        && incoming().uid == existing().uid
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && (
          isAdmin() ||
          (
            request.auth.uid == userId
            && incoming().role == existing().role
            && incoming().status == existing().status
            && incoming().diff(existing()).affectedKeys().hasOnly(['nama', 'whatsapp', 'soundEnabled', 'updatedAt'])
          )
        );
      allow delete: if isAdmin() && isValidId(userId);
    }

    match /customers/{customerId} {
      allow get: if isSignedIn() && isValidId(customerId) && (existing().ownerUid == request.auth.uid || isAdmin());
      allow list: if isAdminToken() || (isSignedIn() && resource.data.ownerUid == request.auth.uid);
      allow create: if isVerifiedUser() && isValidId(customerId) && isValidCustomerRecord(incoming())
        && incoming().id == customerId && incoming().updatedAt == request.time
        && (
          isAdmin() ||
          (
            incoming().ownerUid == request.auth.uid
            && incoming().activeLoan == 0
            && incoming().monthlyInstallment == 0
            && incoming().paidInstallments == 0
            && incoming().totalInstallments == 0
            && incoming().remainingDebt == 0
            && incoming().loans.size() == 0
            && incoming().status == 'Aktif'
          )
        );
      allow update: if isAdmin() && isValidId(customerId) && isValidCustomerRecord(incoming())
        && incoming().id == existing().id && incoming().updatedAt == request.time;
      allow delete: if isAdmin() && isValidId(customerId);
    }

    match /savingsAccounts/{accountId} {
      allow get: if isSignedIn() && isValidId(accountId) && (existing().ownerUid == request.auth.uid || isAdmin());
      allow list: if isAdminToken() || (isSignedIn() && resource.data.ownerUid == request.auth.uid);
      allow create: if isVerifiedUser() && isValidId(accountId) && isValidSavingsAccount(incoming())
        && incoming().id == accountId && incoming().updatedAt == request.time
        && (
          isAdmin() ||
          (
            incoming().ownerUid == request.auth.uid
            && incoming().status == 'Aktif'
            && incoming().balance >= 0
          )
        );
      allow update: if isVerifiedUser() && isValidId(accountId) && isValidSavingsAccount(incoming())
        && incoming().id == existing().id && incoming().updatedAt == request.time
        && (
          isAdmin() ||
          (
            existing().ownerUid == request.auth.uid
            && incoming().ownerUid == existing().ownerUid
            && incoming().balance >= existing().balance
            && incoming().diff(existing()).affectedKeys().hasOnly([
              'program', 'routine', 'balance', 'lastDate', 'updatedAt'
            ])
          )
        );
      allow delete: if isAdmin() && isValidId(accountId);
    }

    match /conversations/{conversationId} {
      allow get: if isSignedIn() && isValidId(conversationId) && (existing().customerUid == request.auth.uid || isAdmin());
      allow list: if isAdminToken() || (isSignedIn() && resource.data.customerUid == request.auth.uid);
      allow create: if isVerifiedUser() && isValidId(conversationId) && isValidConversation(incoming())
        && incoming().conversationId == conversationId
        && incoming().conversationId == incoming().customerId
        && incoming().lastMessageAt == request.time
        && (
          isAdmin() ||
          (
            incoming().customerUid == request.auth.uid
            && exists(/databases/$(database)/documents/customers/$(incoming().customerId))
            && get(/databases/$(database)/documents/customers/$(incoming().customerId)).data.ownerUid == request.auth.uid
          )
        );
      allow update: if isVerifiedUser() && isValidId(conversationId) && isValidConversation(incoming())
        && incoming().conversationId == existing().conversationId
        && incoming().customerId == existing().customerId
        && incoming().lastMessageAt == request.time
        && (
          isAdmin() ||
          (
            existing().customerUid == request.auth.uid
            && incoming().customerUid == existing().customerUid
            && incoming().diff(existing()).affectedKeys().hasOnly([
              'lastMessage', 'lastMessageAt', 'unreadAdmin', 'unreadCustomer'
            ])
          )
        );
      allow delete: if isAdmin() && isValidId(conversationId);

      // Pillar 1 Master Gate: Parent conversation verification
      match /messages/{messageId} {
        allow get: if isSignedIn() && isValidId(conversationId) && isValidId(messageId) && (
          get(/databases/$(database)/documents/conversations/$(conversationId)).data.customerUid == request.auth.uid ||
          isAdmin()
        );
        allow list: if isAdminToken() || (isSignedIn() && resource.data.customerUid == request.auth.uid);
        allow create: if isVerifiedUser() && isValidId(conversationId) && isValidId(messageId) && isValidMessage(incoming())
          && incoming().messageId == messageId
          && incoming().conversationId == conversationId
          && incoming().createdAt == request.time
          && existsAfter(/databases/$(database)/documents/conversations/$(conversationId))
          && (
            isAdmin() ||
            (
              getAfter(/databases/$(database)/documents/conversations/$(conversationId)).data.customerUid == request.auth.uid
              && incoming().customerUid == request.auth.uid
              && incoming().senderId == request.auth.uid
              && incoming().senderRole == 'customer'
              && incoming().messageType != 'system_payment'
            )
          );
        allow update: if isVerifiedUser() && isValidId(conversationId) && isValidId(messageId) && isValidMessage(incoming())
          && incoming().messageId == existing().messageId
          && incoming().conversationId == existing().conversationId
          && incoming().createdAt == existing().createdAt
          && (
            isAdmin() ||
            (
              get(/databases/$(database)/documents/conversations/$(conversationId)).data.customerUid == request.auth.uid
              && incoming().diff(existing()).affectedKeys().hasOnly(['status', 'deliveredAt', 'readAt'])
            )
          );
        allow delete: if isAdmin() && isValidId(conversationId) && isValidId(messageId);
      }
    }

    match /transactions/{transactionId} {
      allow get: if isSignedIn() && isValidId(transactionId) && (existing().customerUid == request.auth.uid || isAdmin());
      allow list: if isAdminToken() || (isSignedIn() && resource.data.customerUid == request.auth.uid);
      allow create: if isVerifiedUser() && isValidId(transactionId) && isValidTransaction(incoming())
        && incoming().transactionId == transactionId
        && incoming().createdAt == request.time
        && (
          isAdmin() ||
          (
            incoming().customerUid == request.auth.uid
            && exists(/databases/$(database)/documents/customers/$(incoming().customerId))
            && get(/databases/$(database)/documents/customers/$(incoming().customerId)).data.ownerUid == request.auth.uid
            && (
              (incoming().jenisTransaksi == 'payment_proof' && incoming().status == 'Menunggu Verifikasi') ||
              (incoming().jenisTransaksi == 'savings' && incoming().status == 'Berhasil')
            )
          )
        );
      allow update: if isAdmin() && isValidId(transactionId) && isValidTransaction(incoming())
        && incoming().transactionId == existing().transactionId
        && incoming().createdAt == existing().createdAt;
      allow delete: if false;
    }

    match /notifications/{notificationId} {
      allow get: if isSignedIn() && isValidId(notificationId) && (existing().recipientUid == request.auth.uid || isAdmin());
      allow list: if isAdminToken() || (isSignedIn() && resource.data.recipientUid == request.auth.uid);
      allow create: if isVerifiedUser() && isValidId(notificationId) && isValidNotification(incoming())
        && incoming().notificationId == notificationId
        && incoming().createdAt == request.time
        && (
          isAdmin() ||
          (
            incoming().senderId == request.auth.uid
            && incoming().recipientId == 'ADMIN'
            && incoming().recipientUid == 'ADMIN'
            && incoming().type == 'CHAT_MESSAGE'
            && incoming().isRead == false
          )
        );
      allow update: if isVerifiedUser() && isValidId(notificationId) && isValidNotification(incoming())
        && incoming().notificationId == existing().notificationId
        && incoming().createdAt == existing().createdAt
        && (
          isAdmin() ||
          (
            existing().recipientUid == request.auth.uid
            && incoming().diff(existing()).affectedKeys().hasOnly(['isRead'])
          )
        );
      allow delete: if isAdmin() && isValidId(notificationId);
    }

    match /deviceTokens/{tokenId} {
      allow get: if isSignedIn() && isValidId(tokenId) && (existing().userId == request.auth.uid || isAdmin());
      allow list: if isAdminToken() || (isSignedIn() && resource.data.userId == request.auth.uid);
      allow create: if isVerifiedUser() && isValidId(tokenId) && isValidDeviceToken(incoming())
        && incoming().tokenId == tokenId
        && incoming().userId == request.auth.uid
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time
        && (isAdmin() || incoming().role == 'customer');
      allow update: if isVerifiedUser() && isValidId(tokenId) && isValidDeviceToken(incoming())
        && incoming().tokenId == existing().tokenId
        && existing().userId == request.auth.uid
        && incoming().userId == existing().userId
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && (isAdmin() || incoming().role == existing().role);
      allow delete: if isSignedIn() && isValidId(tokenId) && (existing().userId == request.auth.uid || isAdmin());
    }
  }
}
